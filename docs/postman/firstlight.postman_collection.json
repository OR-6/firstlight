{
  "info": {
    "name": "Firstlight (PayPal sandbox)",
    "description": "Earthquake relief cash in minutes, no application needed. Every public endpoint of the hosted demo, in the order a judge would try them. PayPal SANDBOX only: no real money moves. Requests marked 'sends sandbox money' create a real PayPal sandbox payout batch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://firstlight.onrender.com"
    },
    {
      "key": "planId",
      "value": "1"
    },
    {
      "key": "receiptId",
      "value": "rcpt_0000000000000000"
    }
  ],
  "item": [
    {
      "name": "1. The quake and the plan",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "health"
              ]
            },
            "description": "Sandbox flag and liveness."
          }
        },
        {
          "name": "State",
          "request": {
            "method": "GET",
            "header": [],
