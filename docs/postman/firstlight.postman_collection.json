            "description": "A well-formed token nobody created. Agents cannot grant themselves an allowance: the answer is ALLOWANCE_UNKNOWN.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 6,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"get_allowance\",\n    \"arguments\": {\n      \"allowance_token\": \"alw_fakefakefakefakefakefakefakefake\"\n    }\n  }\n}",
              "options": {
                "raw": {
