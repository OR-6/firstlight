{
  "info": {
    "name": "Firstlight (PayPal sandbox)",
    "description": "Earthquake relief cash in minutes, no application needed. The judge path through the hosted demo's public endpoints. PayPal SANDBOX only: no real money moves.\n\nThe first folder is read-only and safe to run top to bottom with the Collection Runner; each request has tests. The second folder changes the demo's state, and 'Send payouts' creates a real PayPal sandbox payout batch.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://firstlight.onrender.com"
    },
    {
      "key": "planId",
      "value": "1"
    },
    {
      "key": "receiptId",
      "value": "rcpt_0000000000000000"
    }
  ],
  "item": [
    {
      "name": "Read-only (safe to run top to bottom)",
      "description": "GETs, MCP read-only tools and isolated red-team runs. Nothing here changes the live demo or calls PayPal except to read.",
