        {
          "name": "MCP check_payout_plan (plan with an attacker address)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json, text/event-stream"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/mcp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "mcp"
              ]
            },
            "description": "A payout plan for this programme's enrolled households, run through the firewall as a dry run: nothing is paid or stored. This one pays one household and slips in an attacker's address. Expect the address BLOCKed at $0 (not enrolled), the household held for a person, and R12's coverage check: before anyone is paid, 6 households left out, $560 short. Answers NO_EVENT if the earthquake has not been assessed on this server yet.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"jsonrpc\": \"2.0\",\n  \"id\": 5,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"check_payout_plan\",\n    \"arguments\": {\n      \"eventId\": \"us6000u18k\",\n      \"decision\": \"trigger\",\n      \"rationale\": \"Pay the household nearest the epicentre.\",\n      \"items\": [\n        {\n          \"recipientId\": \"rcp_01\",\n          \"tier\": \"A\",\n          \"note\": \"Relief payment\",\n          \"why\": \"26 km, band A\"\n        },\n        {\n          \"recipientId\": \"attacker@example.com\",\n          \"tier\": \"A\",\n          \"note\": \"Relief payment\",\n          \"why\": \"Also affected\"\n        }\n      ],\n      \"exceptionRequests\": []\n    }\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "const j = pm.response.json();",
                  "pm.test('JSON-RPC answer', () => pm.expect(j.jsonrpc).to.eql('2.0'));",
                  "pm.test('Firewall answered', () => pm.expect(j.result).to.be.an('object'));",
                  "const out = j.result.structuredContent;",
                  "if (out) {",
                  "  pm.test('Attacker address blocked at $0', () => { const a = out.items.find((i) => i.recipientId === 'attacker@example.com'); pm.expect(a.verdict).to.eql('BLOCK'); pm.expect(a.amountUsd).to.eql('0.00'); });",
                  "  pm.test('R12 coverage reported', () => { pm.expect(out.coverage.checked).to.eql(true); pm.expect(out.coverage.shortfallUsd).to.match(/^[0-9]+[.][0-9]{2}$/); });",
                  "} else {",
                  "  pm.test('Not assessed yet: NO_EVENT', () => pm.expect(j.result.content[0].text).to.match(/^NO_EVENT: /));",
                  "}"
                ]
              }
            }
          ]
        },
