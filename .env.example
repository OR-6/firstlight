# Firstlight runs against the PayPal SANDBOX only. Never put live credentials here.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
APP_BASE_URL=http://localhost:3000
ANTHROPIC_API_KEY=            # live mode / recording fixtures only
LLM_MODEL=
DEMO_MODE=replay              # replay | live
TIER_A_USD=120
TIER_B_USD=80
TIER_C_USD=40
PER_RECIPIENT_CAP_USD=150
EVENT_CAP_USD=1500
APPROVAL_THRESHOLD_USD=300

# Sandbox PERSONAL account email that receives the $1 smoke-test payout
PAYPAL_SMOKE_RECEIVER=
EXECUTE_LIMIT_PER_HOUR=6       # public-demo cap on real sandbox payout batches per hour
RESET_COOLDOWN_MS=60000        # minimum gap between demo resets
FIREWALL_KILL_SWITCH=          # set to 1 to block every payout (R7)
FIRSTLIGHT_DB=data/firstlight.db
# PAYEES_JSON={"rcp_01":"someone@personal.example.com"}   # alternative to config/payees.sandbox.json
FIRSTLIGHT_URL=http://localhost:3000   # where npm run samaritan sends its MCP calls
FIRSTLIGHT_ALLOWANCE_TOKEN=     # alw_… from /agents, for npm run samaritan
PAYPAL_HOSTED_MCP=on            # off: confirm receipts with the Server SDK only
FIRSTLIGHT_RESETTABLE_DEMO=     # true/false; see README (default true in replay mode)
