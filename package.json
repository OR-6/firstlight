{
  "name": "firstlight",
  "version": "0.1.0",
  "private": true,
  "description": "Disaster-relief cash payouts proposed by an AI agent, gated by a deterministic payment firewall. SANDBOX ONLY.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "fetch:usgs": "tsx scripts/fetch-usgs.ts",
    "paypal:check": "tsx --env-file-if-exists=.env scripts/paypal-smoke-payout.ts",
    "smoke:payout": "tsx --env-file-if-exists=.env scripts/paypal-smoke-payout.ts",
    "fl": "tsx --env-file-if-exists=.env scripts/fl.ts",
    "record:fixtures": "tsx --env-file-if-exists=.env scripts/fl.ts assess --llm record",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "redteam": "tsx --env-file-if-exists=.env scripts/redteam.ts",
    "samaritan": "tsx scripts/samaritan.ts",
    "webhook:register": "tsx --env-file-if-exists=.env scripts/register-webhook.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@paypal/paypal-server-sdk": "^2.5.0",
    "ag-grid-community": "^36.3.0",
    "ag-grid-react": "^36.3.0",
    "better-sqlite3": "^13.0.3",
    "leaflet": "^1.9.4",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "server-only": "^0.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
